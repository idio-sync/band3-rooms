# Copy to .env and fill in. ROOMS_ADDRESS is the one you need.

# The server's host name exactly as players enter it in their game (band3's
# liveless_rooms_server without the :port, RB3Enhanced's LivelessAddress).
# Login proofs are signed with it. Comma-separated for more than one.
ROOMS_ADDRESS=rooms.example.com

# Ask for login proofs, and check emulators' ones against ROOMS_ADDRESS
ROOMS_REQUIRE_PROOF=true
# Take logins from real Xbox 360s, whose signed proofs can't be checked
ROOMS_ALLOW_CONSOLES=true

# Client versions, comma-separated prefixes of the version each game sends
# (band3: "idio-sync/band3 <build>"; RB3Enhanced: its build tag). With
# ROOMS_ALLOW_VERSIONS set only those are let in; ROOMS_DENY_VERSIONS turns
# those away and wins. Blank = everyone.
ROOMS_ALLOW_VERSIONS=
ROOMS_DENY_VERSIONS=

# If some players share a network with the server, the server's public IPv4,
# given to games that connect from a private or loopback address
ROOMS_LAN_PUBLIC_IP=

# Times are Go durations (10s, 1m) or seconds; 0 = never
ROOMS_PING=10s
ROOMS_TIMEOUT=30s
ROOMS_LOGIN_TIMEOUT=30s

# Limits; 0 = no limit
ROOMS_MAX_CONNS=1000
ROOMS_MAX_CONNS_PER_IP=16
# Failed joins (no such code) per minute, per connection and per IP address
ROOMS_CONN_JOIN_MISSES=5
ROOMS_IP_JOIN_MISSES=20

# Log every frame in hex
ROOMS_HEX=false

# Set by the Docker image; for running the binary elsewhere
# ROOMS_LISTEN=0.0.0.0:19532
# ROOMS_HEALTH=127.0.0.1:19580
